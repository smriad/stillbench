OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:4b
# Local Ollama does not check this. OpenRouter and the droplet need a real bearer token.
# A blank value on Render is treated as unset (briefs use the built-in writer).
OLLAMA_API_KEY=ollama

# Everything below is optional. Each one switches on a piece; the walk works without any of them.

# TabPFN scores every bench you could walk to and picks the farthest one you will still go to.
PRIORLABS_API_KEY=

# ElevenLabs speaks the brief, rings the end-of-sit chime, and hears the spoken debrief.
# The key needs text_to_speech, sound_generation, and speech_to_text permissions.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Temporal keeps the sit timer on the server, so a sleeping phone still finishes the sit.
# Local: `npm run temporal:dev` then `npm run worker`. Temporal Cloud: add namespace and API key.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# Sentry traces the Mastra agent and workflow, TabPFN, ElevenLabs, and Tinker calls.
SENTRY_DSN=

# MongoDB Atlas stores walks and attempts. Without it they live in data/.
MONGODB_URI=
MONGODB_DB=stillbench

# SerpApi finds real parks near home once: `npm run benches:find`.
# Home is used only for that one search, never per walk.
SERPAPI_API_KEY=
STILLBENCH_HOME=23.7806,90.4070

# Tinker: after `python tinker/train_briefs.py`, half the briefs come from the tuned model.
TINKER_API_KEY=
TINKER_BRIEF_MODEL=

# Arduino pocket buzzer (hardware/stillbench_pebble). Any long random string.
STILLBENCH_DEVICE_TOKEN=

# Backboard remembers debriefs and may suggest one line for the next brief.
# Run `npm run backboard:assistant` once to create "Stillbench memory" and fill the id.
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

# Tiger Data / Timescale logs each sit or bail in sit_events.
TIGER_DATABASE_URL=
