// At the bench, this is your phone's hotspot. The phone can stay in the bag.
#define SECRET_SSID "your-hotspot"
#define SECRET_PASS "your-hotspot-password"
// The deployed app (port 443), or the laptop running `npm run dev` (port 3000).
#define STILLBENCH_HOST "stillbench.onrender.com"
#define STILLBENCH_PORT 443
// Same value as STILLBENCH_DEVICE_TOKEN on the server.
#define STILLBENCH_DEVICE_TOKEN "change-me"
